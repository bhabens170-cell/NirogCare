# NirogCare Environment Variables

# Google Gemini API Key (FREE)
# Get your API key from: https://makersuite.google.com/app/apikey
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Supabase Configuration (only if using Supabase features)
# VITE_SUPABASE_URL=your_supabase_url
# VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_key

# Supabase Edge Function – AI model overrides (set these in your Supabase project secrets)
# Health-chat model (default: openai/gpt-5.4-codex)
# HEALTH_CHAT_MODEL=openai/gpt-5.4-codex
# Prescription-analysis model (default: anthropic/claude-opus-4.6)
# PRESCRIPTION_MODEL=anthropic/claude-opus-4.6
